{
	"name": "theoremai-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "THEOREM site: React Router v8 on Cloudflare Workers \u2014 docs, studio, and the run host.",
	"scripts": {
		"predev": "node --experimental-strip-types scripts/ensure-theoremai.mjs",
		"dev": "react-router dev --port 5174 --strictPort",
		"prebuild": "node --experimental-strip-types scripts/ensure-theoremai.mjs && npm run docs:vectors:check",
		"docs:compose": "node scripts/docs-compose.mjs",
		"docs:model": "node scripts/docs-model.mjs",
		"docs:vectors": "node scripts/docs-vectors.mjs",
		"docs:vectors:check": "node scripts/docs-vectors.mjs --check",
		"docs:search-check": "node scripts/docs-search-check.mjs",
		"evals:th30": "node scripts/evals-th30.mjs",
		"docs:ack": "node scripts/docs-covers.mjs ack",
		"lint:docs": "npm run docs:compose && node scripts/docs-lint-snippets.mjs && node scripts/docs-check-snippets.mjs && node scripts/docs-check-facts.mjs && node scripts/docs-covers.mjs check && node scripts/docs-lint-voice.mjs && node scripts/docs-lint-dates.mjs && npm run docs:vectors:check",
		"build": "react-router build",
		"preview": "npm run build && vite preview",
		"deploy": "node scripts/deploy.mjs",
		"postinstall": "patch-package && node --experimental-strip-types scripts/ensure-theoremai.mjs",
		"precheck": "node --experimental-strip-types scripts/ensure-theoremai.mjs",
		"check": "react-router typegen && tsc --noEmit",
		"test": "deno test -A --no-check --unstable-sloppy-imports --import-map=tests/import-map.json tests",
		"theme": "node scripts/theme.mjs",
		"lint:eslint": "eslint .",
		"lint:eslint:fix": "eslint . --fix && biome check --write .",
		"lint:biome": "biome check --error-on-warnings .",
		"lint:biome:fix": "biome check --write .",
		"lint:fallow": "node --experimental-strip-types scripts/ensure-theoremai.mjs && fallow audit && fallow health && fallow dupes && fallow dead-code",
		"lint:theme": "node scripts/theme.mjs --check",
		"lint:stills": "node scripts/lint-stills.mjs && node --experimental-strip-types scripts/stills.mjs --check",
		"stills": "node --experimental-strip-types scripts/stills.mjs",
		"lint": "npm run lint:theme && npm run lint:stills && npm run lint:eslint && npm run lint:biome && npm run lint:fallow",
		"theoremai:ensure": "node --experimental-strip-types scripts/ensure-theoremai.mjs",
		"theoremai:pull": "git -C ../theoremai pull --ff-only origin main"
	},
	"dependencies": {
		"@astryxdesign/core": "0.7.1",
		"@astryxdesign/theme-neutral": "0.7.1",
		"@fontsource/figtree": "^5.3.0",
		"@huggingface/transformers": "^3.8.1",
		"@orama/orama": "^3.1.18",
		"@stylexjs/stylex": "0.19.0",
		"@tabler/icons-react": "^3.48.0",
		"@theoremjs/agents": "file:../theoremai",
		"@theoremjs/studio": "file:../theoremai/studio",
		"@theoremjs/react": "file:../theoremai/react",
		"isbot": "^5.2.2",
		"onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.4.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@cloudflare/vite-plugin": "^1.58.0",
		"@cloudflare/workers-types": "^5.20260924.1",
		"@eslint/js": "^9.39.5",
		"@react-router/dev": "^8.4.0",
		"@types/node": "^22.19.15",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"fallow": "3.17.0",
		"globals": "^16.5.0",
		"patch-package": "^8.0.1",
		"sharp": "^0.35.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.4",
		"wrangler": "^4.137.0"
	},
	"overrides": {
		"@huggingface/transformers": {
			"sharp": "$sharp"
		}
	}
}
