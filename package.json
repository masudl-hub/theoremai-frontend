{
	"name": "theorum-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "Interactive site for THEORUM — flat agent kernel docs and playground.",
	"scripts": {
		"predev": "node --experimental-strip-types scripts/ensure-theorum.mjs",
		"dev": "node --experimental-strip-types scripts/sync-cloud-css.mjs && vite dev",
		"prebuild": "node --experimental-strip-types scripts/ensure-theorum.mjs",
		"build": "node --experimental-strip-types scripts/sync-cloud-css.mjs && vite build",
		"deploy": "npm run build && wrangler pages deploy .svelte-kit/cloudflare --project-name=theorum",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"postinstall": "node --experimental-strip-types scripts/ensure-theorum.mjs",
		"precheck": "node --experimental-strip-types scripts/ensure-theorum.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint:eslint": "node --experimental-strip-types scripts/sync-cloud-css.mjs && eslint .",
		"lint:eslint:fix": "eslint . --fix && biome check --write .",
		"lint:biome": "biome check .",
		"lint:biome:fix": "biome check --write .",
		"lint:fallow": "fallow audit && fallow health && fallow dupes && fallow dead-code",
		"lint": "npm run lint:eslint && npm run lint:biome && npm run lint:fallow",
		"theorum:ensure": "node --experimental-strip-types scripts/ensure-theorum.mjs",
		"theorum:sync": "git submodule update --init --recursive",
		"theorum:pull": "git -C theorum pull --ff-only origin main || git -C ../theorum pull --ff-only origin main"
	},
	"dependencies": {
		"@openrouter/ai-sdk-provider": "^3.0.0",
		"@sveltejs/kit": "^2.63.0",
		"@xyflow/svelte": "^1.6.5",
		"ai": "^7.0.0",
		"gpt-tokenizer": "^4.0.0",
		"svelte": "^5.56.1",
		"tailwindcss": "^4.3.3",
		"theorum": "file:./theorum",
		"zod": "^4.1.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@eslint/js": "^9.39.5",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/load-config": "^0.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.19.15",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"fallow": "3.17.0",
		"globals": "^16.5.0",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.0.16",
		"wrangler": "^4.45.3"
	}
}
