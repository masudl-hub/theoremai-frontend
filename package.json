{
	"name": "theoremai-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "THEOREM site: React Router v8 on Cloudflare Workers — docs, playground, and the run host.",
	"scripts": {
		"predev": "node --experimental-strip-types scripts/ensure-theoremai.mjs",
		"dev": "react-router dev",
		"prebuild": "node --experimental-strip-types scripts/ensure-theoremai.mjs",
		"build": "react-router build",
		"preview": "npm run build && vite preview",
		"deploy": "npm run build && wrangler deploy",
		"postinstall": "node --experimental-strip-types scripts/ensure-theoremai.mjs",
		"precheck": "node --experimental-strip-types scripts/ensure-theoremai.mjs",
		"check": "react-router typegen && tsc --noEmit",
		"lint:eslint": "eslint .",
		"lint:eslint:fix": "eslint . --fix && biome check --write .",
		"lint:biome": "biome check --error-on-warnings .",
		"lint:biome:fix": "biome check --write .",
		"lint:fallow": "node --experimental-strip-types scripts/ensure-theoremai.mjs && fallow audit && fallow health && fallow dupes && fallow dead-code",
		"lint": "npm run lint:eslint && npm run lint:biome && npm run lint:fallow",
		"theoremai:ensure": "node --experimental-strip-types scripts/ensure-theoremai.mjs",
		"theoremai:pull": "git -C ../theoremai pull --ff-only origin main"
	},
	"dependencies": {
		"@astryxdesign/core": "0.6.2",
		"@astryxdesign/theme-neutral": "0.6.2",
		"@openrouter/ai-sdk-provider": "^3.0.0",
		"@stylexjs/stylex": "0.19.0",
		"@theoremai/agents": "file:../theoremai",
		"@theoremai/playground": "file:../theoremai/playground",
		"@theoremai/react": "file:../theoremai/react",
		"ai": "^7.0.0",
		"gpt-tokenizer": "^4.0.0",
		"isbot": "^5.2.2",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.4.0",
		"zod": "^4.1.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@cloudflare/vite-plugin": "^1.58.0",
		"@cloudflare/workers-types": "^5.20260924.1",
		"@eslint/js": "^9.39.5",
		"@react-router/dev": "^8.4.0",
		"@types/node": "^22.19.15",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"fallow": "3.17.0",
		"globals": "^16.5.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.0.16",
		"wrangler": "^4.137.0"
	}
}
