{
	"name": "theorum-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "Interactive site for THEORUM — flat agent kernel docs and playground.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"deploy": "npm run build && wrangler pages deploy .svelte-kit/cloudflare --project-name=theorum",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"theorum:sync": "git submodule update --init --recursive",
		"theorum:pull": "git -C theorum pull --ff-only origin main"
	},
	"dependencies": {
		"@openrouter/ai-sdk-provider": "^3.0.0",
		"@xyflow/svelte": "^1.6.5",
		"ai": "^7.0.0",
		"gpt-tokenizer": "^4.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.19.15",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.45.3"
	}
}
