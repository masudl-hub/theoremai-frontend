{
	"name": "theorum-frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "Interactive site for THEORUM — flat agent kernel docs and playground.",
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"predev": "node --experimental-strip-types scripts/ensure-theorum.mjs && npm run build:run",
		"dev": "node --experimental-strip-types scripts/sync-cloud-css.mjs && vite dev",
		"dev:run": "npm run dev -w @theorum/run",
		"prebuild": "node --experimental-strip-types scripts/ensure-theorum.mjs",
		"build:run": "npm run build -w @theorum/run && node --experimental-strip-types scripts/sync-run-static.mjs",
		"build": "npm run build:run && node --experimental-strip-types scripts/sync-cloud-css.mjs && vite build",
		"deploy": "npm run build && wrangler pages deploy .svelte-kit/cloudflare --project-name=theorum",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"postinstall": "node --experimental-strip-types scripts/ensure-theorum.mjs",
		"precheck": "node --experimental-strip-types scripts/ensure-theorum.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint:eslint": "node --experimental-strip-types scripts/sync-cloud-css.mjs && eslint .",
		"lint:eslint:fix": "eslint . --fix && biome check --write .",
		"lint:biome": "biome check --error-on-warnings .",
		"lint:biome:fix": "biome check --write .",
		"lint:fallow": "node --experimental-strip-types scripts/ensure-theorum.mjs && fallow audit && fallow health && fallow dupes && fallow dead-code",
		"lint": "npm run lint:eslint && npm run lint:biome && npm run lint:fallow",
		"pressure:playground": "npx vite-node scripts/pressure-playground.mjs",
		"pressure:projection": "npx vite-node scripts/pressure-projection.mjs",
		"pressure:demo": "npx vite-node scripts/pressure-demo-tools.mjs",
		"test:tool-resume": "npx vite-node scripts/test-tool-resume.mjs",
		"test:invoke-payload": "npx vite-node scripts/test-invoke-payload.mjs",
		"pressure:interface-voice": "npx vite-node scripts/pressure-interface-voice.mjs",
		"theorum:ensure": "node --experimental-strip-types scripts/ensure-theorum.mjs",
		"theorum:pull": "git -C ../theorum pull --ff-only origin main"
	},
	"dependencies": {
		"@openrouter/ai-sdk-provider": "^3.0.0",
		"@sveltejs/kit": "^2.63.0",
		"@tabler/icons-svelte": "^3.46.0",
		"@theorum/react": "file:../theorum/react",
		"@theorum/playground": "file:../theorum/playground",
		"@xyflow/svelte": "^1.6.5",
		"ai": "^7.0.0",
		"gpt-tokenizer": "^4.0.0",
		"svelte": "^5.56.1",
		"tailwindcss": "^4.3.3",
		"theorum": "file:../theorum",
		"ws": "^8.21.3",
		"zod": "^4.1.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@eslint/js": "^9.39.5",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/load-config": "^0.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.19.15",
		"@types/ws": "^8.18.1",
		"concurrently": "^9.2.4",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"fallow": "3.17.0",
		"globals": "^16.5.0",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.0.16",
		"wrangler": "^4.45.3"
	}
}
