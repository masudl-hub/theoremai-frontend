{
	"include": [
		".react-router/types/**/*",
		"app/**/*",
		"evals/**/*",
		"workers/**/*",
		"theoremai-deno-shim.d.ts"
	],
	// A .d.ts beside a .ts of the same name is dropped from `include`. These are the
	// editor contribution modules, so the file has to be named here to be part of the program.
	"files": [
		"node_modules/@theoremjs/studio/ui/code/monaco-contributions.d.ts",
		"node_modules/@theoremjs/studio/ui/code/studio-type-sources.d.ts"
	],
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["@cloudflare/workers-types", "vite/client"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"forceConsistentCasingInFileNames": true,
		"rootDirs": [".", "./.react-router/types"],
		// @theoremjs/react is compiled from source and ships its own @types/react and Astryx;
		// resolve both to this install so their types unify (and the site theme's variants hold).
		// @theoremjs/studio's screen has no install of its own, so its icons resolve here too.
		// zod as well: two installs a patch apart are two sets of types, and checking a schema
		// from one against the other runs the type-check out of memory.
		"paths": {
			"zod": ["./node_modules/zod"],
			"zod/*": ["./node_modules/zod/*"],
			"@tabler/icons-react": ["./node_modules/@tabler/icons-react"],
			"@astryxdesign/core": ["./node_modules/@astryxdesign/core/dist/index.d.ts"],
			"@astryxdesign/core/*": ["./node_modules/@astryxdesign/core/dist/*/index.d.ts"],
			"react": ["./node_modules/@types/react"],
			"react/*": ["./node_modules/@types/react/*"],
			"react-dom": ["./node_modules/@types/react-dom"],
			"react-dom/*": ["./node_modules/@types/react-dom/*"]
		}
	}
}
