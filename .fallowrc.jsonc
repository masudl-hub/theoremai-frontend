{
	"$schema": "./node_modules/fallow/schema.json",
	"entry": [
		"src/routes/**/+page.{ts,svelte}",
		"src/routes/**/+layout.{ts,svelte}",
		"src/routes/**/+server.ts",
		"src/routes/**/+page.server.ts",
		"src/routes/**/+layout.server.ts",
		"src/hooks.server.ts",
		"src/hooks.client.ts",
		"src/lib/server/live-relay.ts",
		"src/lib/server/th30.ts",
		"src/lib/server/kernel-init.ts",
		"src/lib/components/Playground.svelte",
		"src/app.html",
		"vite.config.ts",
		"scripts/pressure-playground.mjs"
	],
	"ignorePatterns": [
		"theorum/**",
		"node_modules/**",
		".svelte-kit/**",
		".output/**",
		"build/**",
		"coverage/**",
		".fallow/**"
	],
	"ignoreDependencies": ["@openrouter/ai-sdk-provider", "ai", "gpt-tokenizer", "zod"],
	"ignoreExportsUsedInFile": true,
	"rules": {
		"unused-files": "error",
		"unused-exports": "error",
		"unused-types": "error",
		"unused-dependencies": "error",
		"circular-dependency": "error",
		"unresolved-imports": "error",
		"private-type-leaks": "error",
		"boundary-violations": "error",
		"dev-dependencies-in-production": "warn"
	},
	"duplicates": {
		"mode": "strict",
		"minTokens": 40,
		"minLines": 5,
		"minOccurrences": 2,
		"ignoreImports": true
	},
	"health": {
		"maxCyclomatic": 42,
		"maxCognitive": 67,
		"maxCrap": 1723,
		"maxUnitSize": 1040
	},
	"audit": {
		"gate": "all"
	}
}
