{
	"$schema": "./node_modules/fallow/schema.json",
	// React Router framework mode: route modules and the Worker are runtime roots;
	// routes.ts and react-router.config.ts are read by @react-router/dev at build time.
	"framework": [
		{
			"name": "react-router-cloudflare",
			"enablers": ["@react-router/dev"],
			"entryPoints": ["app/root.tsx", "app/routes/*.{ts,tsx}", "workers/app.ts"],
			"entryPointRole": "runtime",
			"configPatterns": [
				"app/routes.ts",
				"react-router.config.ts",
				"vite.config.ts",
				"app/theme.ts"
			],
			"toolingDependencies": ["@react-router/dev"]
		}
	],
	"publicPackages": ["@theoremjs/react"],
	"ignorePatterns": [
		"node_modules/**",
		"**/.react-router/**",
		".wrangler/**",
		"build/**",
		// Generated by `npm run theme`; `npm run lint:theme` checks it matches app/theme.ts.
		"app/built/**",
		"coverage/**",
		".fallow/**"
	],
	"ignoreDependencies": [
		"@openrouter/ai-sdk-provider",
		"ai",
		"gpt-tokenizer",
		"zod",
		// peerDependencies of @theoremjs/react, which the host app must supply.
		"@astryxdesign/core",
		"@astryxdesign/theme-neutral",
		"@stylexjs/stylex",
		// Imported by @react-router/dev's default server entry, not our code.
		"isbot",
		// Build tooling: app/routes.ts imports its route helpers, but the build reads
		// that file and never ships it; fallow counts everything under app/ as runtime.
		"@react-router/dev"
	],
	"ignoreExportsUsedInFile": true,
	// compose.ts and chapter-markdown.ts are Vite build roots: scripts/docs-index-plugin.mjs loads
	// them with ssrLoadModule, which fallow cannot follow. The two scripts are run by path:
	// docs-check-facts.mjs runs docs-probe-pairs.ts on deno, and docs-check-snippets.mjs names
	// docs-snippet-host.ts in the tsconfig it writes.
	"entry": [
		"app/lib/docs/compose.ts",
		"app/lib/docs/chapter-markdown.ts",
		"scripts/docs-probe-pairs.ts",
		"scripts/docs-snippet-host.ts"
	],
	// Durable Objects are called by the runtime (`alarm`) and through a stub, a
	// proxy fallow cannot follow (`playgroundSteerInbox` and `takeAllowance` call the RPC methods).
	"usedClassMembers": [
		{
			"extends": "DurableObject",
			"members": ["alarm", "open", "enqueue", "consume", "close", "take"]
		}
	],
	"rules": {
		"unused-files": "error",
		"unused-exports": "error",
		"unused-types": "error",
		"unused-dependencies": "error",
		"unused-dev-dependencies": "error",
		"unused-optional-dependencies": "error",
		"type-only-dependencies": "error",
		"test-only-dependencies": "error",
		"dev-dependencies-in-production": "error",
		"circular-dependency": "error",
		"re-export-cycle": "error",
		"unresolved-imports": "error",
		"private-type-leaks": "error",
		"boundary-violations": "error",
		"stale-suppressions": "error",
		"unused-catalog-entries": "error",
		"empty-catalog-groups": "error",
		"unused-dependency-overrides": "error",
		"unused-component-props": "error",
		"unused-svelte-events": "error",
		"unused-load-data-keys": "error",
		"unrendered-components": "error",
		"invalid-client-export": "error",
		"mixed-client-server-barrel": "error",
		"misplaced-directive": "error",
		"css-token-drift": "error",
		"css-duplicate-block": "error",
		"css-selector-complexity": "error",
		"css-dead-surface": "error",
		"css-broken-reference": "error"
	},
	"duplicates": {
		"mode": "strict",
		"minTokens": 40,
		"minLines": 5,
		"minOccurrences": 2,
		"ignoreImports": true,
		// Hard ceiling: any meaningful duplication fails until clone groups are cleared.
		"threshold": 1
	},
	"health": {
		"maxCyclomatic": 20,
		"maxCognitive": 15,
		"maxCrap": 381,
		"maxUnitSize": 210
	},
	"audit": {
		"gate": "all"
	}
}
