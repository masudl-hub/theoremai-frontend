{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"files": {
		"includes": [
			"src/**/*.ts",
			"src/**/*.svelte",
			"src/**/*.css",
			"apps/run/src/**/*.ts",
			"apps/run/src/**/*.tsx",
			"apps/run/src/**/*.css",
			"apps/site/app/**/*.ts",
			"apps/site/app/**/*.tsx",
			"apps/site/workers/**/*.ts",
			"apps/site/*.ts",
			"apps/site/package.json",
			"apps/site/tsconfig.json",
			"apps/site/wrangler.jsonc",
			"vite.config.ts",
			"apps/run/vite.config.ts",
			"biome.json",
			"package.json",
			"apps/run/package.json",
			".fallowrc.jsonc",
			"eslint.config.js",
			"!node_modules",
			"!apps/run/dist",
			"!apps/site/build",
			"!**/.react-router",
			"!.svelte-kit",
			"!.output",
			"!build",
			"!coverage",
			"!.fallow"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "all",
			"semicolons": "always"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		},
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		}
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": {
			"enabled": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noImportantStyles": "error"
			},
			"correctness": {
				"noUnusedVariables": "error",
				"noConstAssign": "error",
				"noConstantCondition": "error"
			},
			"style": {
				"useConst": "error",
				"noNonNullAssertion": "error"
			},
			"suspicious": {
				"noExplicitAny": "error"
			},
			"performance": {
				"noBarrelFile": "off",
				"noReExportAll": "off"
			},
			"a11y": {
				"recommended": false,
				"noLabelWithoutControl": "off",
				"noStaticElementInteractions": "off",
				"useKeyWithMouseEvents": "off",
				"noSvgWithoutTitle": "off",
				"useSemanticElements": "off",
				"noNoninteractiveElementToInteractiveRole": "off",
				"useButtonType": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off"
					},
					"a11y": {
						"recommended": false
					}
				}
			}
		},
		{
			"includes": ["src/app.d.ts"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off"
					}
				}
			}
		}
	],
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
